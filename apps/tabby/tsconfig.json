{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/app-kit/src/**/*.ts",
    "../../packages/app-kit/src/**/*.tsx"
  ],
  "exclude": [
    "../../packages/app-kit/src/**/*.figma.ts"
  ]
}
